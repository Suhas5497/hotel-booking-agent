# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# (Groq retired llama-3.1-8b-instant on 16 Aug 2026)
LLM_API_KEY=sk_mypbxv1b_zFkMJpDfra7cCrf2md2ixAqY
LLM_TEMPERATURE=0.2

# Local alternative (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# --- Voice (optional) ---
# Listening uses Whisper on the same provider and key as the chat model by default.
# STT_MODEL=whisper-large-v3-turbo
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=

# Gia's voice: Sarvam Bulbul (https://dashboard.sarvam.ai). Without a key the browser's voice is used.
SARVAM_API_KEY=
# SARVAM_SPEAKER=shubh          # male voices: shubh, aditya, kabir, rohan, rahul, amit, dev...
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_PACE=1.0               # 0.5-2.0; 1.0 is natural speed
# SARVAM_TEMPERATURE=0.65       # 0.01-1.0; higher is more expressive

# --- App ---
GOODFOODS_TZ=Asia/Kolkata
# GOODFOODS_DB=data/goodfoods.db
# Freeze the clock for reproducible demos:
# GOODFOODS_NOW=2026-10-12T16:00
